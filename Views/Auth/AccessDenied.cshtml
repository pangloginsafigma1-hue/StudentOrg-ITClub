@{
    ViewData["Title"] = "Access Denied";
}
<main class="login-shell">
    <section class="login-card">
        <div class="login-brand"><img src="~/images/somams-mark.svg" alt="" /><span>SOMAMS</span></div>
        <h1>Access denied</h1>
        <p class="login-subtitle">This account does not have permission to open that page.</p>
        @if (User.IsInRole("Member"))
        {
            <a class="btn btn-primary login-submit" asp-controller="MemberPortal" asp-action="Index">Go to Member Portal</a>
        }
        else
        {
            <a class="btn btn-primary login-submit" asp-controller="Dashboard" asp-action="Index">Go to Dashboard</a>
        }
    </section>
</main>
