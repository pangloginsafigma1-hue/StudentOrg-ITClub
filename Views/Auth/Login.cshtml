@model ITClubOrg.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<main class="login-shell">
    <section class="login-card" aria-labelledby="login-title">
        <div class="login-brand">
            <img src="~/images/logo.png" alt="" />
            <span>SOMAMS</span>
        </div>
        <p class="login-eyebrow">College of Computer Studies</p>
        <h1 id="login-title">Welcome back</h1>
        <p class="login-subtitle">Administrator sign-in to manage your student organization.</p>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (ViewData["DatabaseError"] is string databaseError)
        {
            <div class="alert alert-warning login-alert" role="alert">@databaseError</div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert" role="alert"></div>

        <form asp-controller="Auth" asp-action="Login" method="post" class="login-form">
            <div class="form-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password"></label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" id="passwordInput" />
                    <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false" data-password-toggle>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.3-6 9.5-6 9.5 6 9.5 6-3.3 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.8" /></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="login-options">
                <label class="remember-option">
                    <input asp-for="RememberMe" />
                    <span>Remember me</span>
                </label>
                <a asp-controller="ForgotPassword" asp-action="Index">Forgot password?</a>
            </div>
            <button class="btn btn-primary login-submit" type="submit">Sign In</button>
        </form>

        <p class="login-footer">Student Organization Membership and Management System</p>
        <p class="login-footer"><a asp-controller="MemberAccess" asp-action="Login">Member Portal sign in</a></p>
    </section>
</main>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
