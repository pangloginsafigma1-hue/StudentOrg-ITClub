@model ITClubOrg.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<main class="login-shell login-shell-redesign">
    <aside class="login-intro" aria-label="SOMAMS introduction">
        <div class="login-intro-brand">
            <img src="~/images/somams-mark.svg" alt="" />
            <span><strong>SOMAMS</strong><small>Student Organization</small></span>
        </div>
        <div class="login-intro-copy">
            <span class="login-intro-kicker">College of Computer Studies</span>
            <h2>Make every member moment count.</h2>
            <p>A shared space to support your organization, bring people together, and keep the work moving.</p>
        </div>
        <div class="login-intro-foot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3 4 6v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-3Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
            <span>One place for your organization to thrive</span>
        </div>
    </aside>
    <section class="login-card login-card-redesign" aria-labelledby="login-title">
        <p class="login-eyebrow">Administrator access</p>
        <h1 id="login-title">Welcome back</h1>
        <p class="login-subtitle">Sign in to manage your student organization.</p>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (ViewData["DatabaseError"] is string databaseError)
        {
            <div class="alert alert-warning login-alert" role="alert">@databaseError</div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert" role="alert"></div>

        <form asp-controller="Auth" asp-action="Login" method="post" class="login-form">
            <div class="form-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password"></label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" id="passwordInput" />
                    <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false" data-password-toggle>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.3-6 9.5-6 9.5 6 9.5 6-3.3 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.8" /></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="login-options">
                <label class="remember-option">
                    <input asp-for="RememberMe" />
                    <span>Remember me</span>
                </label>
                <a asp-controller="ForgotPassword" asp-action="Index">Forgot password?</a>
            </div>
            <button class="btn btn-primary login-submit" type="submit">Sign In</button>
        </form>

        <p class="login-footer portal-switch-footer">
            Need the member portal? <a class="portal-switch-link" data-portal-transition asp-controller="MemberAccess" asp-action="Login">Member Portal sign in</a>
        </p>
    </section>
</main>
