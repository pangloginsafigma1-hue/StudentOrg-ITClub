@model MemberPortalViewModel
<section class="page-card">
    <h2>Announcements</h2>
    @if (Model.Announcements.Count == 0)
    {
        <p class="empty-state">No announcements have been published yet.</p>
    }
    else
    {
        @foreach (var announcement in Model.Announcements)
        {
            <article class="announcement-card">
                <header class="announcement-card-header">
                    <div class="announcement-title-group">
                        <span class="announcement-scope">@(announcement.DivisionName ?? "Organization-wide")</span>
                        <h3>@announcement.Title</h3>
                    </div>
                </header>
                <p class="announcement-body">@announcement.Body</p>
                <footer class="announcement-meta">
                    <span class="announcement-author">
                        <strong>@announcement.PublisherName</strong>
                        <span>@announcement.PublisherPosition</span>
                    </span>
                    <span class="announcement-posted">
                        Posted <time datetime="@announcement.CreatedAt.ToString("O")">@announcement.CreatedAt.ToString("MMM d, yyyy 'at' h:mm tt")</time>
                    </span>
                </footer>
            </article>
        }
    }
</section>
