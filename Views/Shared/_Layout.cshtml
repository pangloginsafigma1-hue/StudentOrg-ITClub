@using ITClubOrg.Services
@{
    var activeSection = ViewData["ActiveSection"] as string ?? "dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#172554" />
    <title>@ViewData["Title"] - SOMAMS</title>
    <link rel="icon" type="image/svg+xml" href="~/images/somams-mark.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <a class="skip-link" href="#mainContent">Skip to content</a>
    <aside class="sidebar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index" aria-label="SOMAMS dashboard">
            <img src="~/images/somams-mark.svg" alt="" />
            <span class="brand-copy">
                <strong>SOMAMS</strong>
                <small>Student Organization</small>
            </span>
        </a>

        <nav class="sidebar-nav" aria-label="Main navigation">
            @foreach (var item in NavigationCatalog.Items)
            {
                if (item.Key == "user-roles" && !User.IsInRole("SuperAdmin"))
                {
                    continue;
                }

                var controller = item.Key switch
                {
                    "dashboard" => "Dashboard",
                    "membership" => "Members",
                    "activities" => "Activities",
                    "attendance" => "Attendance",
                    "reports" => "Reports",
                    "settings" => "Settings",
                    "announcements" => "Announcements",
                    "user-roles" => "AdminAccounts",
                    _ => "Modules"
                };
                var action = item.Key switch
                {
                    "dashboard" or "membership" => "Index",
                    "activities" => "Index",
                    "attendance" => "Index",
                    "reports" => "Index",
                    "settings" => "Index",
                    "user-roles" => "Index",
                    "announcements" => "Index",
                    _ => "Index"
                };
                var routeSection = controller == "Modules" ? item.Key : null;
                @if (item.Key == "announcements")
                {
                    <a class="sidebar-link @(activeSection == item.Key ? "active" : "")"
                       href="@Url.Action("Index", "Announcements")"
                       aria-current="@(activeSection == item.Key ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 13V9a2 2 0 0 1 2-2h2l9-4v16l-9-4H6a2 2 0 0 1-2-2Z" />
                                <path d="m8 15 1.5 5h3L11 16" />
                                <path d="M20 9v4" />
                            </svg>
                        </span>
                        <span>@item.Title</span>
                    </a>
                }
                else
                {
                    <a class="sidebar-link @(activeSection == item.Key ? "active" : "")"
                       asp-controller="@controller"
                       asp-action="@action"
                       asp-route-section="@routeSection"
                       aria-current="@(activeSection == item.Key ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                @if (item.Key == "dashboard")
                                {
                                    <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
                                    <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
                                    <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
                                    <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
                                }
                                else if (item.Key == "activities")
                                {
                                    <rect x="3.5" y="5" width="17" height="16" rx="2" />
                                    <path d="M7.5 3v4M16.5 3v4M3.5 10h17" />
                                }
                                else if (item.Key == "attendance")
                                {
                                    <circle cx="12" cy="12" r="9" />
                                    <path d="m8 12 2.5 2.5L16.5 9" />
                                }
                                else if (item.Key == "membership")
                                {
                                    <circle cx="9" cy="8" r="3" />
                                    <path d="M3.5 20v-1a5.5 5.5 0 0 1 11 0v1M16 5.5a3 3 0 0 1 0 5.8M17 15a4.5 4.5 0 0 1 3.5 4.4v.6" />
                                }
                                else if (item.Key == "reports")
                                {
                                    <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
                                }
                                else if (item.Key == "settings")
                                {
                                    <circle cx="12" cy="12" r="3" />
                                    <path d="m19.4 15 .1.1 1.3 1-1.5 2.6-1.6-.6a7.8 7.8 0 0 1-1.5.9l-.3 1.7h-3l-.3-1.7a7.8 7.8 0 0 1-1.5-.9l-1.6.6-1.5-2.6 1.3-1a7 7 0 0 1 0-1.8l-1.3-1 1.5-2.6 1.6.6a7.8 7.8 0 0 1 1.5-.9l.3-1.7h3l.3 1.7a7.8 7.8 0 0 1 1.5.9l1.6-.6 1.5 2.6-1.3 1a7 7 0 0 1 0 1.7Z" />
                                }
                                else
                                {
                                    <path d="M12 3 4 6v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-3Z" />
                                    <path d="m9 12 2 2 4-4" />
                                }
                            </svg>
                        </span>
                        <span>@item.Title</span>
                    </a>
                }
            }
        </nav>

        <button class="sidebar-link sidebar-logout" type="button" data-bs-toggle="modal" data-bs-target="#logoutModal">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 17l5-5-5-5M15 12H3" />
                    <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" />
                </svg>
            </span>
            <span>Logout</span>
        </button>
    </aside>

    <main class="main-content" id="mainContent">
        <header class="page-header">
            <div>
                <h1>@ViewData["Title"]</h1>
                <p>@ViewData["Description"]</p>
                <span class="title-accent" aria-hidden="true"></span>
            </div>
            <div class="signed-in">
                <span>Signed in as</span>
                <strong>@User.Identity?.Name</strong>
                <small>@(User.FindFirst("division_name")?.Value ?? "Super Admin")</small>
            </div>
        </header>

        <div class="page-body">
            @RenderBody()
        </div>
    </main>

    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content logout-modal">
                <div class="modal-header">
                    <h2 class="modal-title" id="logoutModalLabel">Confirm Logout</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to log out of SOMAMS?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button class="btn btn-danger" type="submit">Yes, Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
