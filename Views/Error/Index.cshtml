@{
    ViewData["Title"] = "Something went wrong";
}

<main class="login-shell">
    <section class="login-card">
        <h1>Something went wrong</h1>
        <p>The request could not be completed. Please try again.</p>
        <a class="btn btn-primary login-submit" asp-controller="Auth" asp-action="Login">Return to Login</a>
    </section>
</main>
