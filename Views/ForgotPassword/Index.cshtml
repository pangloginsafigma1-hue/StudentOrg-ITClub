@model ITClubOrg.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    var emailStep = Model.Step == "email";
    var codeStep = Model.Step == "code";
}

<main class="login-shell recovery-shell">
    <section class="login-card recovery-card" aria-labelledby="recovery-title">
        <div class="login-brand">
            <img src="~/images/somams-mark.svg" alt="" />
            <span>SOMAMS</span>
        </div>
        <p class="login-eyebrow">Account recovery</p>
        <h1 id="recovery-title">Forgot Password</h1>
        @if (emailStep)
        {
            <p class="login-subtitle">Enter your administrator email address to request a verification code.</p>
        }
        else if (codeStep)
        {
            <p class="login-subtitle">Enter the 6-digit code sent to your email. The code expires in 10 minutes.</p>
        }
        else
        {
            <p class="login-subtitle">Choose a new password for your administrator account.</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-info recovery-message" role="status">@Model.Message</div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert" role="alert"></div>

        @if (emailStep)
        {
            <form asp-controller="ForgotPassword" asp-action="SendCode" method="post" class="login-form">
                <input asp-for="FlowToken" type="hidden" />
                <div class="form-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" type="email" maxlength="100" autocomplete="email" required />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Send Verification Code</button>
            </form>
            <p class="recovery-privacy-note">For privacy, this page does not confirm whether an email address belongs to an administrator account. If no code arrives, contact your system administrator to check email setup.</p>
        }
        else if (codeStep)
        {
            <form asp-controller="ForgotPassword" asp-action="VerifyCode" method="post" class="login-form">
                <input asp-for="FlowToken" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <div class="form-field">
                    <label asp-for="Code"></label>
                    <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
                    <span asp-validation-for="Code" class="field-error"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Verify Code</button>
            </form>
        }
        else
        {
            <form asp-controller="ForgotPassword" asp-action="ResetPassword" method="post" class="login-form">
                <input asp-for="FlowToken" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <div class="form-field">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" minlength="6" maxlength="64" required />
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" minlength="6" maxlength="64" required />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Save New Password</button>
            </form>
        }
        <a class="recovery-back-link" asp-controller="Auth" asp-action="Login">Back to Login</a>
    </section>
</main>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
