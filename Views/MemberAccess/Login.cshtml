@model MemberLoginViewModel
@{
    ViewData["Title"] = "Member Sign In";
}
<main class="login-shell login-shell-redesign">
    <aside class="login-intro" aria-label="SOMAMS introduction">
        <div class="login-intro-brand">
            <img src="~/images/somams-mark.svg" alt="" />
            <span><strong>SOMAMS</strong><small>Student Organization</small></span>
        </div>
        <div class="login-intro-copy">
            <span class="login-intro-kicker">College of Computer Studies</span>
            <h2>Your organization. Your community.</h2>
            <p>Stay connected to your membership, upcoming activities, attendance, and the latest updates.</p>
        </div>
        <div class="login-intro-foot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="8" r="3" />
                <path d="M3.5 20v-1a5.5 5.5 0 0 1 11 0v1M16 5.5a3 3 0 0 1 0 5.8M17 15a4.5 4.5 0 0 1 3.5 4.4v.6" />
            </svg>
            <span>Stay in the know and part of the action</span>
        </div>
    </aside>
    <section class="login-card login-card-redesign" aria-labelledby="login-title">
        <p class="login-eyebrow">Member portal</p>
        <h1 id="login-title">Welcome back</h1>
        <p class="login-subtitle">Sign in to see your membership and activities.</p>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert" role="alert"></div>
        <form asp-action="Login" method="post" class="login-form">
            <div class="form-field">
                <label asp-for="MemberId"></label>
                <input asp-for="MemberId" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="MemberId" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="login-options">
                <label class="remember-option">
                    <input asp-for="RememberMe" />
                    <span>Remember me</span>
                </label>
                <a asp-controller="MemberPassword" asp-action="ForgotPassword">Forgot password?</a>
            </div>
            <button class="btn btn-primary login-submit" type="submit">Sign In</button>
        </form>
        <p class="login-footer">New to SOMAMS? <a asp-action="Register">Register for the organization</a></p>
        <p class="login-footer portal-switch-footer">
            Administrator? <a class="portal-switch-link" data-portal-transition asp-controller="Auth" asp-action="Login">Admin sign in</a>
        </p>
    </section>
</main>
