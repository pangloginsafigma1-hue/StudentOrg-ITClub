@model AnnouncementFormViewModel
<section class="page-card">
    <h2>Create a post</h2>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <form asp-action="Create" method="post" class="member-request-form">
        <div class="form-field">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Body"></label>
            <textarea asp-for="Body" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Body" class="field-error"></span>
        </div>
        @if (User.IsInRole("SuperAdmin"))
        {
            <div class="form-field">
                <label>Audience <small>(choose up to 2)</small></label>
                <details class="division-dropdown" data-division-dropdown data-max-selections="2">
                    <summary class="division-dropdown-trigger">
                        <span data-division-label>Select an audience</span>
                        <span class="division-dropdown-chevron" aria-hidden="true"></span>
                    </summary>
                    <div class="division-dropdown-menu" role="group" aria-label="Announcement audience">
                        <label class="division-check-option">
                            <input type="checkbox" name="DivisionIds" value="" checked="@(Model.DivisionIds.Length == 0 ? "checked" : null)" />
                            <span>All divisions (organization-wide)</span>
                        </label>
                        @foreach (var division in Model.Divisions)
                        {
                            <label class="division-check-option">
                                <input type="checkbox" name="DivisionIds" value="@division.DivisionId" checked="@(Model.DivisionIds.Contains(division.DivisionId) ? "checked" : null)" />
                                <span>@division.Name</span>
                            </label>
                        }
                    </div>
                </details>
                <span asp-validation-for="DivisionIds" class="field-error"></span>
            </div>
        }
        <div class="member-actions">
            <button class="btn btn-primary" type="submit">Post</button>
            <a class="btn btn-outline-primary" asp-action="Index">Back</a>
        </div>
    </form>
</section>
