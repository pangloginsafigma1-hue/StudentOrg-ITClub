@model IReadOnlyList<MemberAnnouncement>
@using ITClubOrg.Services
@{
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var divisionScope = UserDivision.GetDivisionId(User);
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (ViewData["DatabaseError"] is string databaseError)
{
    <div class="alert alert-danger" role="alert">@databaseError</div>
}
<section class="page-card">
    <div class="members-toolbar">
        <div><h2>Published Announcements</h2><p>Members see organization-wide and division announcements in their portal.</p></div>
        <a class="btn btn-primary" asp-action="Create">Create a post</a>
    </div>
    @if (Model.Count == 0)
    {
        <p class="empty-state">No announcements have been published yet.</p>
    }
    else
    {
        @foreach (var announcement in Model)
        {
            var canDeleteAnnouncement = isSuperAdmin
                || divisionScope.HasValue
                    && (announcement.DivisionId == divisionScope || announcement.DivisionId2 == divisionScope);
            <article class="announcement-card">
                <header class="announcement-card-header">
                    <div class="announcement-title-group">
                        <span class="announcement-scope">@(announcement.DivisionName ?? "Organization-wide")</span>
                        <h3>@announcement.Title</h3>
                    </div>
                    @if (canDeleteAnnouncement)
                    {
                        <button class="btn btn-outline-danger announcement-delete-button" type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteAnnouncement-@announcement.AnnouncementId"
                                aria-label="Delete announcement: @announcement.Title">
                            <img src="~/images/ic_delete.png" alt="" />
                            <span>Delete</span>
                        </button>
                    }
                </header>
                <p class="announcement-body">@announcement.Body</p>
                <footer class="announcement-meta">
                    <span class="announcement-author">
                        <strong>@announcement.PublisherName</strong>
                        <span>@announcement.PublisherPosition</span>
                    </span>
                    <span class="announcement-posted">
                        Posted <time datetime="@announcement.CreatedAt.ToString("O")">@announcement.CreatedAt.ToString("MMM d, yyyy 'at' h:mm tt")</time>
                    </span>
                </footer>
            </article>
            @if (canDeleteAnnouncement)
            {
                <div class="modal fade" id="deleteAnnouncement-@announcement.AnnouncementId" tabindex="-1"
                     aria-labelledby="deleteAnnouncementTitle-@announcement.AnnouncementId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content logout-modal">
                            <div class="modal-header">
                                <h2 class="modal-title" id="deleteAnnouncementTitle-@announcement.AnnouncementId">Delete announcement?</h2>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Delete “@announcement.Title”? Members will no longer see this post.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                                <form asp-controller="Announcements" asp-action="Delete" method="post">
                                    <input type="hidden" name="announcementId" value="@announcement.AnnouncementId" />
                                    <button class="btn btn-danger" type="submit">Yes, Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</section>
