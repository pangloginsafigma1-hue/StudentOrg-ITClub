@model ITClubOrg.Models.MemberForgotPasswordViewModel
@{
    ViewData["Title"] = "Member Password Recovery";
}
<main class="login-shell recovery-shell">
    <section class="login-card recovery-card" aria-labelledby="recovery-title">
        <div class="login-brand">
            <img src="~/images/somams-mark.svg" alt="" />
            <span>SOMAMS</span>
        </div>
        <p class="login-eyebrow">Member account recovery</p>
        <h1 id="recovery-title">Forgot Password</h1>
        <p class="login-subtitle">Recover your member portal access using your registration email.</p>
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-info recovery-message" role="status">@Model.Message</div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert" role="alert"></div>
        @if (Model.Step == "email")
        {
            <form asp-action="SendCode" method="post" class="login-form">
                <input asp-for="FlowToken" type="hidden" />
                <div class="form-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" required />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Send Verification Code</button>
            </form>
        }
        else if (Model.Step == "code")
        {
            <form asp-action="VerifyCode" method="post" class="login-form">
                <input asp-for="FlowToken" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <div class="form-field">
                    <label asp-for="Code">Verification code</label>
                    <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
                    <span asp-validation-for="Code" class="field-error"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Verify Code</button>
            </form>
        }
        else
        {
            <form asp-action="ResetPassword" method="post" class="login-form">
                <input asp-for="FlowToken" type="hidden" />
                <div class="form-field">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required />
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Save New Password</button>
            </form>
        }
        <a class="recovery-back-link" asp-controller="MemberAccess" asp-action="Login">Back to Member Login</a>
    </section>
</main>
