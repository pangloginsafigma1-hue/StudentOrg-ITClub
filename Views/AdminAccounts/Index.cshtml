@model ITClubOrg.Models.UserRolesViewModel
@{
    ViewData["Title"] = "User Roles";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (Model.DatabaseError is string databaseError)
{
    <div class="alert alert-danger" role="alert">@databaseError</div>
}

<section class="page-card admin-account-card">
    <div class="members-toolbar">
        <div>
            <h2>Administrator Accounts</h2>
            <p>Create administrators and manage their division access.</p>
        </div>
        <div class="member-actions">
            <a class="btn btn-primary" asp-controller="AdminAccounts" asp-action="Create">Add Administrator</a>
        </div>
    </div>

    @if (Model.AdministratorAccounts.Count > 0)
    {
        <div class="table-responsive">
            <table class="table somams-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Role</th>
                        <th scope="col">Division</th>
                        <th scope="col">Current term</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="actions-heading">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model.AdministratorAccounts)
                    {
                        <tr>
                            <td>@account.FullName</td>
                            <td>@account.Username</td>
                            <td>@account.Email</td>
                            <td>@(account.Role == "SuperAdmin" ? "Super Admin" : "Division Admin")</td>
                            <td>@(account.DivisionName ?? "All divisions")</td>
                            <td>
                                @if (account.CurrentPosition is null)
                                {
                                    <span class="text-muted">No term recorded</span>
                                }
                                else
                                {
                                    <strong>@account.CurrentPosition</strong>
                                    <small class="d-block text-muted">
                                        @account.CurrentTermStart?.ToString("MMM d, yyyy")
                                        –
                                        @(account.CurrentTermEnd?.ToString("MMM d, yyyy") ?? "Present")
                                    </small>
                                }
                            </td>
                            <td>
                                <span class="status-badge @(account.IsActive ? "status-active" : "status-inactive")">
                                    @(account.IsActive ? "Active" : "Disabled")
                                </span>
                            </td>
                            <td class="actions-cell account-actions">
                                <a class="btn btn-account-manage"
                                   asp-controller="AdminAccounts"
                                   asp-action="Edit"
                                   asp-route-id="@account.AdminId">Manage</a>
                                <button class="btn btn-sm btn-outline-primary"
                                        type="button"
                                        data-bs-toggle="modal"
                                        data-bs-target="#adminTermModal"
                                        data-admin-term-id="@account.AdminId"
                                        data-admin-term-name="@account.FullName"
                                        data-admin-term-position="@(account.Role == "SuperAdmin" ? "President" : "Division Head")">
                                    Record term
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="member-list-footer">
            <strong>Total administrator accounts: @Model.AdministratorAccounts.Count</strong>
            <span>At least one active super admin must remain enabled.</span>
        </div>
    }
    else if (Model.DatabaseError is null)
    {
        <p class="empty-state">No administrator accounts were found.</p>
    }
</section>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}

<div class="modal fade" id="adminTermModal" tabindex="-1" aria-labelledby="adminTermModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content logout-modal">
            <div class="modal-header">
                <h2 class="modal-title" id="adminTermModalTitle">Record administrator term</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="AdminAccounts" asp-action="AssignTerm" method="post">
                <div class="modal-body">
                    <p id="adminTermModalDescription">Record a position term.</p>
                    <input type="hidden" name="adminId" id="adminTermId" />
                    <div class="form-field">
                        <label for="adminTermPosition">Position</label>
                        <input class="form-control" name="position" id="adminTermPosition" maxlength="100" required />
                    </div>
                    <div class="form-field">
                        <label for="adminTermStart">Start date</label>
                        <input class="form-control" name="termStart" id="adminTermStart" type="date" required />
                    </div>
                    <div class="form-field">
                        <label for="adminTermEnd">End date <small>(optional)</small></label>
                        <input class="form-control" name="termEnd" id="adminTermEnd" type="date" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save term</button>
                </div>
            </form>
        </div>
    </div>
</div>

<section class="page-card admin-account-card">
    <div class="members-toolbar">
        <div>
            <h2>Member Accounts</h2>
            <p>Manage approved member portal access and passwords.</p>
        </div>
    </div>
    @if (Model.MemberAccounts.Count == 0)
    {
        <p class="empty-state">No approved member portal accounts were found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table somams-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Student ID</th>
                        <th scope="col">Role</th>
                        <th scope="col">Division</th>
                        <th scope="col">Membership</th>
                        <th scope="col">Portal Access</th>
                        <th scope="col" class="actions-heading">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model.MemberAccounts)
                    {
                        <tr>
                            <td>@account.FullName</td>
                            <td>@account.MemberId</td>
                            <td>Member</td>
                            <td>@(account.DivisionName ?? "Unassigned")</td>
                            <td>@account.MembershipStatus</td>
                            <td>
                                <span class="status-badge @(account.IsPortalAccountActive ? "status-active" : "status-inactive")">
                                    @(account.IsPortalAccountActive ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td class="actions-cell account-actions">
                                <form asp-controller="AdminAccounts"
                                      asp-action="SetMemberAccountStatus"
                                      method="post"
                                      class="d-inline">
                                    <input type="hidden" name="memberId" value="@account.MemberId" />
                                    <input type="hidden" name="isActive" value="@(!account.IsPortalAccountActive)" />
                                    <button class="btn @(account.IsPortalAccountActive ? "btn-account-disable" : "btn-account-enable")" type="submit">
                                        @(account.IsPortalAccountActive ? "Disable" : "Enable")
                                    </button>
                                </form>
                                <details class="member-password-reset">
                                    <summary class="btn btn-account-reset">Reset password</summary>
                                    <form asp-controller="AdminAccounts"
                                          asp-action="ResetMemberPassword"
                                          method="post"
                                          class="member-password-reset-form">
                                        <input type="hidden" name="MemberId" value="@account.MemberId" />
                                        <label for="newPassword-@account.MemberId">New password</label>
                                        <input id="newPassword-@account.MemberId"
                                               name="NewPassword"
                                               type="password"
                                               class="form-control"
                                               autocomplete="new-password"
                                               minlength="12"
                                               maxlength="72"
                                               required />
                                        <label for="confirmPassword-@account.MemberId">Confirm password</label>
                                        <input id="confirmPassword-@account.MemberId"
                                               name="ConfirmPassword"
                                               type="password"
                                               class="form-control"
                                               autocomplete="new-password"
                                               minlength="12"
                                               maxlength="72"
                                               required />
                                        <button class="btn btn-primary btn-sm" type="submit">Save password</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="member-list-footer">
            <strong>Total member accounts: @Model.MemberAccounts.Count</strong>
            <span>Member accounts require an Active membership record to sign in.</span>
        </div>
    }
</section>
